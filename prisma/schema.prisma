// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Master Table (Every item exists here first)
model Part {
  id                  Int     @id @default(autoincrement())
  name                String
  brand               String
  category            String // CPU, GPU, RAM, etc
  searchQuery         String? // eBay search keyword, e.g. name plus chipset or capacity

  // Relations to specific specs
  cpuDetails          Cpu?
  motherboardDetails  Motherboard?
  ramDetails          Ram?
  storageDetails      Storage?
  psuDetails          Psu?
  gpuDetails          Gpu?
  coolerDetails       Cooler?

  priceCache          PriceCache?

  // The frontend and saved builds identify parts by name, so a name can't
  // repeat within a category. Also the index /api/price looks parts up by
  @@unique([category, name])
  @@map("parts_test")
}

// Last eBay price lookup per part, reused until it's a few hours old
model PriceCache {
  id            Int       @id @default(autoincrement())
  part          Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  partId        Int       @unique
  priceCad      Float     // median of the usable listings, 0 if there were none
  listingCount  Int       // how many listings the median came from
  fetchedAt     DateTime
}

// A saved build, opened by link at /build/<id>. There are no accounts yet, so
// only the browser that created it can change it: it keeps a secret edit token,
// and the server stores just the token's hash
// eBay Browse API calls made per UTC day, shared by every server instance, so
// the app stays under eBay's daily quota
model EbayUsage {
  day           String    @id // "YYYY-MM-DD" (UTC)
  calls         Int

  @@map("ebay_usage")
}

model Build {
  id            String    @id // short random slug used in share links
  name          String
  parts         Json      // { cpu: "Part name", ... } for the selected categories only
  editTokenHash String    // sha256 hex of the edit token
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("builds")
}

model Cpu {
  id        Int   @id @default(autoincrement())
  part      Part  @relation(fields: [partId], references: [id])
  partId    Int   @unique
  socket    String 
  cores     Int
  threads   Int
  wattage   Int
}

model Motherboard {
  id            Int   @id @default(autoincrement())
  part          Part  @relation(fields: [partId], references: [id])
  partId        Int   @unique
  socket        String
  formFactor    String
  ramSlots      Int
  memoryType    String  @default("Unknown") // e.g., "DDR4", "DDR5"; inferred from name/socket
  hasWifi       Boolean @default(false)
}

model Ram {
  id          Int   @id @default(autoincrement())
  part        Part  @relation(fields: [partId], references: [id])
  partId      Int   @unique
  capacityGb  Int
  stickSize Int
  stickCount  Int
  speedMhz    Int
  generation  String
}

model Storage {
  id            Int     @id @default(autoincrement())
  part          Part    @relation(fields: [partId], references: [id])
  partId        Int     @unique
  capacityGb    Int     // e.g., 1000 (for 1TB)  
  type          String  //e.g., "SSD", "HDD"
  interface     String  //e.g., "NVMe", "SATA"
}

model Psu {
  id          Int   @id @default(autoincrement())
  part        Part  @relation(fields: [partId], references: [id])
  partId      Int   @unique
  wattage     Int
  efficiency  String?  //e.g., "80+ Gold"
  modularity  String  //e.g., "Full", "Semi", "None"
  size        String  //e.g., "ATX"
}

model Gpu {
  id        Int   @id @default(autoincrement())
  part      Part  @relation(fields: [partId], references: [id])
  partId    Int   @unique
  chipset   String
  vramGb    Int
}

model Cooler {
  id          Int   @id @default(autoincrement())
  part        Part  @relation(fields: [partId], references: [id])
  partId      Int   @unique
  rpm         Int?
  noise_level Float?
}